{
  "name": "yajavis-ui",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./jarvisd/ui/src/components/*",
    "#helpers/*": "./jarvisd/ui/src/helpers/*",
    "#state/*": "./jarvisd/ui/src/state/*"
  },
  "engines": {
    "node": "^22.17.0 || >=24"
  },
  "scripts": {
    "build": "npm run build:installer && npm run build:panel",
    "build:installer": "vite build --mode installer",
    "build:panel": "cd jarvisd/ui && vite build"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.58.0",
    "vite": "8.3.8"
  }
}
